{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/tools/house-flip-calculator/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "storm.soulstormai.com"
        }
      ],
      "destination": "/storm/index.html"
    },
    {
      "source": "/:path((?!storm/).*)",
      "has": [
        {
          "type": "host",
          "value": "storm.soulstormai.com"
        }
      ],
      "destination": "/storm/:path"
    }
  ]
}
